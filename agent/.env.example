# Copy to .env.local (it is gitignored) and fill in. LiveKit injects LIVEKIT_URL,
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET itself when the agent runs on LiveKit Cloud.

# Ollama Cloud key (https://ollama.com/settings/keys). Required.
OLLAMA_API_KEY=

# Optional overrides
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com/v1
# Speech-to-text language: multi (default, Hindi/English mixes), or a fixed code like en-IN or hi
# STT_LANGUAGE=multi
# Cartesia language and voice used by the deployed bilingual agent. Use en for
# an English-only deployment.
# TTS_LANGUAGE=hi
# TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# Microphone filter on LiveKit Cloud: nc (default, background noise, no extra cost), off,
# or bvc (also removes other voices, billed extra, untested)
# NOISE_CANCELLATION=nc
# Recognised words needed before the caller counts as interrupting (0 = default; 1 made real
# interruptions slower and did not stop background chatter)
# INTERRUPTION_MIN_WORDS=0
# AGENT_NAME=cryonis-agent
